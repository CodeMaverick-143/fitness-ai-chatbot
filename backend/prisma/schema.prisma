generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Chat {
  id        Int      @id @default(autoincrement())
  role      String // "user" or "ai"
  content   String
  timestamp DateTime @default(now())
}
